# Copy this file to .env for local development. Never commit .env.

# ── Application ─────────────────────────────────────────────
APP_NAME=Sentinel
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────────
# SQLite (default). PostgreSQL can be used instead, e.g.
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=sqlite+aiosqlite:///./data/sentinel.db

# ── Storage ─────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
MAX_ATTACHMENT_BYTES=5242880
RETENTION_DAYS=30

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Analysis limits ─────────────────────────────────────────
MODULE_TIMEOUT_SECONDS=30
URL_FETCH_ENABLED=true
URL_FETCH_TIMEOUT_SECONDS=8
URL_MAX_REDIRECTS=5
URL_MAX_RESPONSE_BYTES=1048576
URL_ANALYSIS_MAX_URLS=50
ALLOW_PRIVATE_URL_FETCH=false
DNS_LOOKUPS_ENABLED=true
RDAP_ENABLED=false

# ── Threat intelligence (all optional) ──────────────────────
# Leave blank to disable. Missing integrations are reported as UNAVAILABLE,
# never treated as "safe".
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# ── ClamAV (optional) ───────────────────────────────────────
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── ML ──────────────────────────────────────────────────────
# The newest directory under this path is used unless ML_ACTIVE_VERSION is set.
ML_ARTIFACT_DIR=./ml/artifacts
ML_ACTIVE_VERSION=
